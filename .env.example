# Variables para desplegar con docker-compose.yml. En Dokploy se escriben en la
# pestaña Environment; en local, copia este archivo como .env y rellénalo.
# El .env nunca se sube al repositorio ni entra en la imagen.

# Obligatoria. Se genera con: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# 1 si el dominio va con HTTPS (lo normal en Dokploy con un dominio propio).
SESSION_COOKIE_SECURE=1

# Zona horaria de las fechas de préstamo, vencimientos y multas.
TZ=America/Lima
