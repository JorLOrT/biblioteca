# ---- Material de entrega, no forma parte de la aplicación -----------------
# Documentos del trabajo y las capturas e scripts que solo sirven para armarlos.
# La aplicación funciona sin nada de esto.
*.docx
*.pdf
*.pptx
*.odt
docs/
capturas/

# ---- Base de datos de la aplicación --------------------------------------
# Se regenera sola al arrancar, con los libros de ejemplo.
library.db
*.db
*.sqlite
*.sqlite3
*.db-journal

# ---- Entornos virtuales ---------------------------------------------------
.venv/
venv/
env/
ENV/

# ---- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- Pruebas y cobertura --------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---- Flask ----------------------------------------------------------------
instance/
.webassets-cache
flask_session/

# ---- Variables de entorno (¡nunca subir la SECRET_KEY!) -------------------
.env
.env.*
!.env.example

# ---- Editores e IDEs ------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ---- macOS ----------------------------------------------------------------
.DS_Store
.AppleDouble
._*
.Spotlight-V100
.Trashes

