# Entornos virtuales del host (son de macOS, no sirven dentro del contenedor)
.venv/
venv/

# Caché de Python — el ** hace que aplique también a subcarpetas
**/__pycache__
**/*.py[cod]

# La base de datos se genera dentro del contenedor al arrancar
*.db
*.sqlite3

# Metadatos y documentación que la imagen no necesita
.git/
.gitignore
README.md
*.log

# Herramientas de revisión del código y sus cachés: la imagen no las usa
pyproject.toml
requirements-dev.txt
stubs/
.mypy_cache/
.ruff_cache/
.DS_Store

# Material de entrega (Word, PDF, capturas y sus scripts): no es la aplicación
*.docx
*.pdf
*.pptx
*.odt
docs/
capturas/
